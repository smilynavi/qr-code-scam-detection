<li about="#cite_note-122" id="cite_note-122" data-mw-footnote-number="122"><span class="mw-cite-backlink" id="mwCx4"><a href="#cite_ref-122" rel="mw:referencedBy" id="mwCx8"><span class="mw-linkback-text" id="mwCyA">↑</span></a></span> <span id="mw-reference-text-cite_note-122" class="mw-reference-text reference-text"><link rel="mw-deduplicated-inline-style" href="mw-data:TemplateStyles:r1333433106" about="#mwt457" typeof="mw:Extension/templatestyles mw:Transclusion" id="mwCyE" data-mw='{"name":"templatestyles","attrs":{"src":"Module:Citation/CS1/styles.css"},"body":{"extsrc":""},"parts":[{"template":{"target":{"wt":"cite web ","href":"./Template:Cite_web"},"params":{"url":{"wt":"http://www.cyveillanceblog.com/malware/qr-codes-a-recipe-for-a-mobile-malware-tsunami"},"title":{"wt":"QR Codes: A Recipe for a Mobile Malware Tsunami"},"publisher":{"wt":"Cyveillance, Inc"},"date":{"wt":"20 October 2010"},"access-date":{"wt":"31 August 2011"},"archive-url":{"wt":"https://web.archive.org/web/20120414131041/http://www.cyveillanceblog.com/malware/qr-codes-a-recipe-for-a-mobile-malware-tsunami"},"archive-date":{"wt":"14 April 2012"}},"i":0}}]}'/><cite class="citation web cs1" about="#mwt457" id="mwCyI"><a rel="mw:ExtLink nofollow" href="https://web.archive.org/web/20120414131041/http://www.cyveillanceblog.com/malware/qr-codes-a-recipe-for-a-mobile-malware-tsunami" class="external text" id="mwCyM">"QR Codes: A Recipe for a Mobile Malware Tsunami"</a>. Cyveillance, Inc. 20 October 2010. Archived from <a rel="mw:ExtLink nofollow" href="http://www.cyveillanceblog.com/malware/qr-codes-a-recipe-for-a-mobile-malware-tsunami" class="external text" id="mwCyQ">the original</a> on 14 April 2012<span class="reference-accessdate" id="mwCyU">. Retrieved <span class="nowrap" id="mwCyY">31 August</span> 2011</span>.</cite><span title="ctx_ver=Z39.88-2004&amp;rft_val_fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=QR+Codes%3A+A+Recipe+for+a+Mobile+Malware+Tsunami&